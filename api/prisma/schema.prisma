generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  female
  male
}

enum Intent {
  dating
  buddy
  both
}

enum ExperienceLevel {
  newbie
  confident
  experienced
  pro
}

enum PrivacyMode {
  open
  anonymous
}

enum FeedbackCategory {
  technical
  question
  suggestion
  safety
  other
}

enum FeedbackStatus {
  new
  open
  in_progress
  resolved
  closed
}

enum FeedbackSenderType {
  user
  admin
}

enum WorkoutFelt {
  easy
  normal
  hard
}

enum ConversationStatus {
  pending
  accepted
}

enum ChatMessageStatus {
  sent
  delivered
  read
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  /** Public findable handle, e.g. masha_ddx — without @ */
  username         String          @unique
  /** Optional Instagram handle without @ */
  instagram        String          @default("")
  name             String
  age              Int             @default(25)
  gender           Gender          @default(male)
  bio              String          @default("")
  photos           String[]        @default([])
  avatar           String          @default("")
  city             String          @default("")
  homeGymId        String?
  intent           Intent          @default(both)
  experienceLevel  ExperienceLevel @default(confident)
  interests        String[]        @default([])
  sports           String[]        @default([])
  isCoach          Boolean         @default(false)
  coachSports      String[]        @default([])
  visitSlots       Json            @default("[]")
  breakUntil       String?
  privacy          PrivacyMode     @default(open)
  lookingToMeet    Boolean         @default(true)
  /** Show circle status sticker / chrome on the public avatar */
  referralStatusVisible Boolean    @default(true)
  /** Cached credited invitees — keep in sync on onboard / attach / delete */
  referralCreditedCount Int        @default(0)
  onboardingDone   Boolean         @default(false)
  isAdmin          Boolean         @default(false)
  isMasterAdmin    Boolean         @default(false)
  adminPermissions Json?
  registeredAt     DateTime        @default(now())
  lastSeenAt       DateTime        @default(now())
  /** Client IP at registration (admin abuse / shared-IP review) */
  signupIp         String          @default("")
  /** Soft-delete: аккаунт анонимизирован, чаты сохраняются */
  deletedAt        DateTime?
  /** Bump to invalidate all JWTs (password change / reset / soft-delete) */
  tokenVersion     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  gyms               UserGym[]
  checkIns           CheckIn[]
  likesGiven         Like[]              @relation("LikesGiven")
  likesReceived      Like[]              @relation("LikesReceived")
  notifications      Notification[]
  notificationPrefs  NotificationPrefs?
  pushSubscriptions  PushSubscription[]
  feedbackTickets    FeedbackTicket[]
  conversationsLow   Conversation[]      @relation("ConvLow")
  conversationsHigh  Conversation[]      @relation("ConvHigh")
  chatMessagesSent   ChatMessage[]
  blocksGiven        UserBlock[]         @relation("BlocksGiven")
  blocksReceived     UserBlock[]         @relation("BlocksReceived")
  invitesSent        Invite[]            @relation("InvitesSent")
  passwordResetTokens PasswordResetToken[]
  workoutSessions     WorkoutSession[]
  workoutCoachReports WorkoutCoachReport[]
  workoutAiInsights   WorkoutAiInsight[]
  broadcastsCreated   AdminBroadcast[]

  @@index([email])
  @@index([city])
  @@index([username])
  @@index([deletedAt])
  @@index([signupIp])
  @@index([lastSeenAt])
}

/** One-time password reset links (raw token never stored — only sha256 hash). */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * Audit log for forgot/reset password (admin spam & forgetfulness analytics).
 * status: sent | no_account | blocked | send_failed | completed | rate_limited
 */
model PasswordResetEvent {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  ip        String   @default("")
  status    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([status])
  @@index([userId])
}

/** Anonymous funnel events from /lp ads landing (+ register from lp) */
model LandingEvent {
  id          String   @id @default(cuid())
  name        String
  visitorId   String
  sessionId   String   @default("")
  placement   String   @default("")
  path        String   @default("/lp")
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  utmContent  String   @default("")
  utmTerm     String   @default("")
  fromParam     String   @default("")
  referrer      String   @default("")
  searchEngine  String   @default("")
  searchKeyword String   @default("")
  clickId       String   @default("")
  searchPaid    Boolean  @default(false)
  userAgent     String   @default("")
  ip            String   @default("")
  userId        String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([visitorId, name, createdAt])
  @@index([utmCampaign, createdAt])
  @@index([sessionId, name])
  @@index([searchEngine, createdAt])
}

/** Web Push endpoints for installed PWA (home screen) */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** Dedup: one “собраться на тренировку” ping per slot occurrence */
model WorkoutReminderLog {
  id        String   @id @default(cuid())
  userId    String
  slotKey   String
  createdAt DateTime @default(now())

  @@unique([userId, slotKey])
  @@index([createdAt])
}

/** A blocked B — neither sees the other in hall/chat/likes */
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/** Email ban — enforced on register/login */
model BlockedEmail {
  email       String   @id
  reason      String   @default("")
  blockedById String?
  createdAt   DateTime @default(now())
}

/** IP ban — enforced on register/login and authenticated API */
model BlockedIp {
  ip          String   @id
  reason      String   @default("")
  blockedById String?
  createdAt   DateTime @default(now())
}

/** Key/value flags (e.g. emergency_shutdown) */
model SystemSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Invite {
  id        String   @id @default(cuid())
  inviterId String
  inviteeId String   @unique
  createdAt DateTime @default(now())

  inviter User @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}

model Conversation {
  id              String             @id @default(cuid())
  /** Lexicographically smaller participant id (unique pair key) */
  userLowId       String
  userHighId      String
  initiatedById   String
  status          ConversationStatus @default(pending)
  lastMessageText String             @default("")
  lastMessageAt   DateTime           @default(now())
  unreadLow       Int                @default(0)
  unreadHigh      Int                @default(0)
  /** Per-participant pin (Telegram-style); null = not pinned */
  pinnedLowAt     DateTime?
  pinnedHighAt    DateTime?
  /** Per-participant hide / delete-for-me; null = visible in inbox */
  hiddenLowAt     DateTime?
  hiddenHighAt    DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  userLow  User         @relation("ConvLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User         @relation("ConvHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, lastMessageAt])
  @@index([userHighId, lastMessageAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  status         ChatMessageStatus @default(sent)
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Gym {
  id        String   @id
  name      String
  network   String
  city      String
  district  String   @default("")
  address   String   @default("")
  image     String   @default("")
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  UserGym[]
  checkIns CheckIn[]

  @@index([city])
  @@index([network])
}

model UserGym {
  userId    String
  gymId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([userId, gymId])
  @@index([gymId])
}

model CheckIn {
  id           String    @id @default(cuid())
  userId       String
  gymId        String
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?
  /** When presence auto-expires (default checkedInAt + 3h, +1h per extend) */
  expiresAt    DateTime?
  /** How many +1h extensions used (max 2) */
  extendCount  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, checkedOutAt])
  @@index([userId, checkedOutAt])
  @@index([expiresAt, checkedOutAt])
  @@index([checkedInAt])
}

/** fromUser лайкнул toUser */
model Like {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())

  fromUser User @relation("LikesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([fromUserId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String   @default("")
  href        String?
  gymId       String?
  actorId     String?
  broadcastId String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast AdminBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, read])
  @@index([broadcastId, read])
}

/** Admin announcement to all users — stats via linked Notification rows. */
model AdminBroadcast {
  id             String    @id @default(cuid())
  title          String
  body           String
  createdById    String
  /** Planned audience size at enqueue time. */
  recipientCount Int       @default(0)
  /** pending | sending | sent | failed */
  status         String    @default("pending")
  deliveredCount Int       @default(0)
  failedCount    Int       @default(0)
  /** How many user ids already processed in the fan-out cursor. */
  cursorOffset   Int       @default(0)
  lastError      String    @default("")
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model NotificationPrefs {
  userId           String  @id
  enabled          Boolean @default(true)
  gymNewMembers    Boolean @default(true)
  likes            Boolean @default(true)
  chatRequests     Boolean @default(true)
  checkins         Boolean @default(false)
  coaches          Boolean @default(true)
  system           Boolean @default(true)
  workoutReminders Boolean @default(true)
  /** Admin-only: push when a new user registers */
  newRegistrations Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeedbackTicket {
  id         String           @id @default(cuid())
  userId     String
  category   FeedbackCategory @default(other)
  subject    String
  status     FeedbackStatus   @default(open)
  assigneeId String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages FeedbackMessage[]

  @@index([userId, updatedAt])
  @@index([status])
}

model FeedbackMessage {
  id         String             @id @default(cuid())
  ticketId   String
  senderType FeedbackSenderType
  senderId   String
  senderName String
  text       String
  createdAt  DateTime           @default(now())

  ticket FeedbackTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/** Personal gym notebook — one session (e.g. «Грудь») with exercises and sets. */
model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  title       String
  performedAt DateTime
  /** Optional body weight logged with the session (kg). */
  bodyWeightKg Decimal? @db.Decimal(5, 2)
  notes       String   @default("")
  /** Subjective how-it-felt; null = skipped or legacy row. Never inferred. */
  feedback    WorkoutFelt?
  feedbackPromptedAt DateTime?
  feedbackSetAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises  WorkoutExercise[]

  @@index([userId, performedAt(sort: Desc)])
  @@index([userId, title])
}

model WorkoutExercise {
  id        String @id @default(cuid())
  sessionId String
  name      String
  /** Stable id across renames — used for deltas / progress (empty = name fallback). */
  trackKey  String @default("")
  sortOrder Int    @default(0)

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sets    WorkoutSet[]

  @@index([sessionId, sortOrder])
}

model WorkoutSet {
  id         String  @id @default(cuid())
  exerciseId String
  setIndex   Int
  weightKg   Decimal @db.Decimal(8, 2)
  reps       Int

  exercise WorkoutExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, setIndex])
}

/** Cached weekly GigaChat letter — one row per user per quota window. */
model WorkoutCoachReport {
  id               String   @id @default(cuid())
  userId           String
  periodStart      DateTime
  periodEnd        DateTime
  factsJson        Json
  letterJson       Json
  model            String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([userId, createdAt])
}

/** Cached GigaChat weekly insight — one row per user per kind per quota window. */
model WorkoutAiInsight {
  id               String    @id @default(cuid())
  userId           String
  kind             String    @default("weekly")
  periodStart      DateTime
  periodEnd        DateTime
  inputJson        Json
  inputHash        String
  outputJson       Json
  model            String    @default("")
  promptTokens             Int       @default(0)
  completionTokens         Int       @default(0)
  promptVersion            String    @default("")
  viewedAt                 DateTime?
  recommendationClickedAt  DateTime?
  createdAt                DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodStart])
  @@index([userId, createdAt])
}

/** Failed API requests for the admin “site health” board. */
model OpsFault {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  method    String
  path      String
  status    Int
  code      String
  title     String
  meaning   String
  message   String   @default("")
  userId    String?

  @@index([createdAt])
  @@index([path, status, createdAt])
}
