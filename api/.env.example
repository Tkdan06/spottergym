DATABASE_URL=postgresql://spotter:spotter@localhost:5432/spotter?schema=public
JWT_SECRET=dev-spotter-jwt-secret
PORT=3001
CORS_ORIGIN=http://localhost:5173
MASTER_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_EMAILS=

# Web Push for PWA home-screen icon (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@spottergym.ru

# Password reset emails via Sendsay (issue.send / personal)
# Setup checklist:
# 1) Sendsay → add sender domain spottergym.ru
# 2) DNS: SPF + DKIM + DMARC from Sendsay
# 3) Create API key for sublogin
# 4) From email must be verified in Sendsay
# 5) Test: POST issue.send group=personal to your inbox
# Docs: https://docs.sendsay.ru/sendsay-api/how-to-send-transactional-campaigns/
SENDSAY_LOGIN=
SENDSAY_APIKEY=
SENDSAY_FROM_EMAIL=noreply@spottergym.ru
SENDSAY_FROM_NAME=Spotter
# Public site URL used in reset links
APP_PUBLIC_URL=http://localhost:5173

# GigaChat weekly workout letter (optional — empty = local facts only, no paid calls)
# Authorization Key from studio.sber.ru (same value as GIGACHAT_AUTH_KEY)
GIGACHAT_CREDENTIALS=
# GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/
GIGACHAT_MODEL=GigaChat
GIGACHAT_COACH_PERIOD_DAYS=7
# Russian Trusted Root CA PEM (НУЦ Минцифры). Default: api/certs/russian_trusted_root_ca.pem
# GIGACHAT_CA_FILE=
