# Скопируй: cp .env.prod.example .env.prod
# Заполни пароли. Файл .env.prod на сервер — не в git.

POSTGRES_USER=spotter
POSTGRES_PASSWORD=замени-на-длинный-случайный-пароль-базы
POSTGRES_DB=spotter

# Минимум 32 символа, уникальная строка
JWT_SECRET=замени-на-случайную-строку-минимум-32-символа-xxxx

CORS_ORIGIN=https://spottergym.ru,https://www.spottergym.ru

# Единственный админ Spotter
MASTER_ADMIN_EMAIL=tkdan@ya.ru
# Пусто — дополнительных админов нет
SEED_ADMIN_EMAILS=

# Web Push (PWA): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tkdan@ya.ru

