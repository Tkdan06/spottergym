# Скопируй: cp .env.prod.example .env.prod
# Заполни пароли. Файл .env.prod на сервер — не в git.

POSTGRES_USER=spotter
POSTGRES_PASSWORD=замени-на-длинный-случайный-пароль-базы
POSTGRES_DB=spotter

# Минимум 32 символа, уникальная строка
JWT_SECRET=замени-на-случайную-строку-минимум-32-символа-xxxx

CORS_ORIGIN=https://spottergym.ru,https://www.spottergym.ru

# Единственный админ Spotter (только на сервере, не в клиентском бандле)
MASTER_ADMIN_EMAIL=your-admin@example.com
# Пусто — дополнительных админов нет
SEED_ADMIN_EMAILS=

# Web Push (PWA): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@spottergym.ru

# Sendsay transactional mail (password reset)
# Cabinet: domain SPF/DKIM/DMARC + API key + verified From
SENDSAY_LOGIN=
SENDSAY_APIKEY=
SENDSAY_FROM_EMAIL=noreply@spottergym.ru
SENDSAY_FROM_NAME=Spotter
APP_PUBLIC_URL=https://spottergym.ru

# GigaChat weekly workout letter (leave empty to disable paid calls)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/
GIGACHAT_MODEL=GigaChat
GIGACHAT_COACH_PERIOD_DAYS=7

