# Frontend → API (пусто = Vite proxy /api → :3001; на VPS оставь пустым для same-origin /api)
VITE_API_URL=

# Soft client gate (NOT real security — use nginx auth_basic for friends beta)
# VITE_SITE_LOCK_ENABLED=true
# VITE_SITE_LOCK_USER=spotter
# VITE_SITE_LOCK_PASSWORD=change-me

# Optional: Webmaster verification codes (injected into HTML at `npm run build`)
# VITE_YANDEX_VERIFICATION=
# VITE_GOOGLE_SITE_VERIFICATION=
